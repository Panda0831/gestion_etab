// Prisma Schema for Système de Gestion Scolaire / Établissement
// Generated from base.sql and diag_classes.txt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum TypeEtablissement {
  ECOLE
  COLLEGE
  LYCEE
  UNIVERSITE

  @@map("type_etablissement")
}

enum RoleUtilisateur {
  DIRECTEUR
  SECRETAIRE
  COMPTABLE
  PROFESSEUR
  ELEVE
  PARENT

  @@map("role_utilisateur")
}

enum Sexe {
  M
  F

  @@map("sexe")
}

enum StatutInscription {
  INSCRIT
  NON_INSCRIT
  EN_ATTENTE

  @@map("statut_inscription")
}

enum StatutPointage {
  PRESENT
  ABSENT
  RETARD

  @@map("statut_pointage")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI

  @@map("jour_semaine")
}

enum TypeCours {
  COURS
  TD
  TP

  @@map("type_cours")
}

enum TypeMedia {
  VIDEO
  PDF
  IMAGE
  AUDIO

  @@map("type_media")
}

enum TypeEvaluation {
  DEVOIR
  EXAMEN
  RATTRAPAGE
  TP
  CONTROLE

  @@map("type_evaluation")
}

enum Periode {
  BIMESTRE
  TRIMESTRE
  SEMESTRE
  ANNUEL

  @@map("periode")
}

enum ModeNotation {
  CREATIF
  DEFAUT

  @@map("mode_notation")
}

enum TypeTransaction {
  ECOLAGE
  DROIT_INSCRIPTION
  REINSCRIPTION
  FOURNITURE
  AUTRE

  @@map("type_transaction")
}

enum ModePaiement {
  MOBILE_MONEY
  BANQUE
  ESPECE

  @@map("mode_paiement")
}

enum StatutPaiement {
  PAYE
  EN_ATTENTE
  ANNULE

  @@map("statut_paiement")
}

enum TypeCommunication {
  ANNONCE
  NOTIFICATION

  @@map("type_communication")
}

enum SousTypeCommunication {
  ADMISSION_BREVET
  ADMISSION_TEST
  ADMISSION_DOSSIER
  FOURNITURES
  EMPLOI_DU_TEMPS
  TARIFS
  GENERALE
  RESULTAT
  ABSENCE
  PAIEMENT
  NOUVEAU_COURS
  CHANGEMENT_PLANNING

  @@map("sous_type_communication")
}

enum TypeDiscussion {
  CLASSE
  CLUB
  EVENEMENT
  GENERAL

  @@map("type_discussion")
}

enum TypeActivite {
  CLUB
  EVENEMENT

  @@map("type_activite")
}

enum StatutEvenement {
  EN_PREPARATION
  VALIDE
  ANNULE

  @@map("statut_evenement")
}

enum RoleMembre {
  MEMBRE
  BUREAU

  @@map("role_membre")
}

// ==========================================
// MODELS
// ==========================================

model Etablissement {
  id        String            @id @default(uuid()) @db.Uuid
  nom       String            @db.VarChar(255)
  adresse   String?           @db.Text
  telephone String?           @db.VarChar(20)
  email     String?           @unique @db.VarChar(255)
  logo      String?           @db.VarChar(500)
  type      TypeEtablissement
  tarifs    Json?             @default("{}")
  actif     Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")

  utilisateurs      Utilisateur[]
  niveaux           Niveau[]
  matieres          Matiere[]
  emploisDuTemps    EmploiDuTemps[]
  parametreNotation ParametreNotation?
  communications    Communication[]
  clubsEvenements   ClubEvenement[]

  @@map("etablissement")
}

model Utilisateur {
  id                String          @id @default(uuid()) @db.Uuid
  etablissementId   String          @map("etablissement_id") @db.Uuid
  email             String          @db.VarChar(255)
  motDePasse        String          @map("mot_de_passe") @db.VarChar(255)
  nom               String          @db.VarChar(100)
  prenom            String          @db.VarChar(100)
  telephone         String?         @db.VarChar(20)
  role              RoleUtilisateur
  actif             Boolean         @default(true)
  derniereConnexion DateTime?       @map("derniere_connexion")
  createdAt         DateTime        @default(now()) @map("created_at")

  etablissement          Etablissement               @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  parent                 Parent?
  eleve                  Eleve?
  pointages              Pointage[]                  @relation("ProfesseurPointages")
  professeurMatieres     ProfesseurMatiere[]
  emploisDuTemps         EmploiDuTemps[]             @relation("ProfesseurEmplois")
  cours                  Cours[]                     @relation("ProfesseurCours")
  evaluations            Evaluation[]                @relation("ProfesseurEvaluations")
  notesSaisies           Note[]                      @relation("SaisieParUser")
  transactionsValidees   TransactionFinanciere[]     @relation("ValideParComptable")
  communicationsPubliees Communication[]             @relation("PublieParUser")
  communicationsRecues   Communication[]             @relation("DestinataireUser")
  discussionsRejointes   DiscussionMembre[]
  messagesEnvoyes        Message[]
  clubsResponsables      ClubEvenement[]             @relation("ResponsableClub")
  organisationsClubs     ClubEvenementOrganisateur[]
  auditLogs              AuditLog[]

  @@unique([etablissementId, email])
  @@index([etablissementId], map: "idx_utilisateur_etablissement")
  @@index([role], map: "idx_utilisateur_role")
  @@map("utilisateur")
}

model Parent {
  id            String  @id @default(uuid()) @db.Uuid
  utilisateurId String  @unique @map("utilisateur_id") @db.Uuid
  profession    String? @db.VarChar(100)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  enfants     Eleve[]

  @@map("parent")
}

model Eleve {
  id                String            @id @default(uuid()) @db.Uuid
  utilisateurId     String            @unique @map("utilisateur_id") @db.Uuid
  classeId          String?           @map("classe_id") @db.Uuid
  parentId          String?           @map("parent_id") @db.Uuid
  matricule         String            @db.VarChar(50)
  dateNaissance     DateTime?         @map("date_naissance") @db.Date
  lieuNaissance     String?           @map("lieu_naissance") @db.VarChar(255)
  sexe              Sexe?
  statutInscription StatutInscription @default(EN_ATTENTE) @map("statut_inscription")

  utilisateur    Utilisateur             @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  classe         Classe?                 @relation(fields: [classeId], references: [id], onDelete: SetNull)
  parent         Parent?                 @relation(fields: [parentId], references: [id], onDelete: SetNull)
  notes          Note[]
  bulletins      Bulletin[]
  transactions   TransactionFinanciere[]
  adhesionsClubs ClubEvenementMembre[]

  @@index([classeId], map: "idx_eleve_classe")
  @@index([parentId], map: "idx_eleve_parent")
  @@map("eleve")
}

model Pointage {
  id           String         @id @default(uuid()) @db.Uuid
  professeurId String         @map("professeur_id") @db.Uuid
  datePointage DateTime       @map("date_pointage") @db.Date
  heureArrivee DateTime?      @map("heure_arrivee") @db.Time
  heureDepart  DateTime?      @map("heure_depart") @db.Time
  statut       StatutPointage @default(PRESENT)
  createdAt    DateTime       @default(now()) @map("created_at")

  professeur Utilisateur @relation("ProfesseurPointages", fields: [professeurId], references: [id], onDelete: Cascade)

  @@map("pointage")
}

model Niveau {
  id              String  @id @default(uuid()) @db.Uuid
  etablissementId String  @map("etablissement_id") @db.Uuid
  nom             String  @db.VarChar(100)
  cycle           String? @db.VarChar(50)
  ordre           Int?

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  classes       Classe[]
  fournitures   Fourniture[]

  @@unique([etablissementId, nom])
  @@map("niveau")
}

model Classe {
  id            String @id @default(uuid()) @db.Uuid
  niveauId      String @map("niveau_id") @db.Uuid
  nom           String @db.VarChar(100)
  anneeScolaire String @map("annee_scolaire") @db.VarChar(20)
  effectif      Int    @default(0)

  niveau         Niveau          @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  eleves         Eleve[]
  emploisDuTemps EmploiDuTemps[]
  cours          Cours[]
  evaluations    Evaluation[]

  @@map("classe")
}

model Matiere {
  id              String  @id @default(uuid()) @db.Uuid
  etablissementId String  @map("etablissement_id") @db.Uuid
  nom             String  @db.VarChar(100)
  code            String? @db.VarChar(20)
  coefficient     Decimal @default(1.00) @db.Decimal(4, 2)

  etablissement  Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  professeurs    ProfesseurMatiere[]
  emploisDuTemps EmploiDuTemps[]
  cours          Cours[]
  evaluations    Evaluation[]

  @@unique([etablissementId, code])
  @@map("matiere")
}

model ProfesseurMatiere {
  id           String @id @default(uuid()) @db.Uuid
  professeurId String @map("professeur_id") @db.Uuid
  matiereId    String @map("matiere_id") @db.Uuid

  professeur Utilisateur @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  matiere    Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([professeurId, matiereId])
  @@map("professeur_matiere")
}

model EmploiDuTemps {
  id              String      @id @default(uuid()) @db.Uuid
  etablissementId String      @map("etablissement_id") @db.Uuid
  classeId        String      @map("classe_id") @db.Uuid
  matiereId       String      @map("matiere_id") @db.Uuid
  professeurId    String?     @map("professeur_id") @db.Uuid
  jour            JourSemaine
  heureDebut      DateTime    @map("heure_debut") @db.Time
  heureFin        DateTime    @map("heure_fin") @db.Time
  salle           String?     @db.VarChar(50)

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere       Matiere       @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  professeur    Utilisateur?  @relation("ProfesseurEmplois", fields: [professeurId], references: [id], onDelete: SetNull)

  @@map("emploi_du_temps")
}

model Fourniture {
  id          String  @id @default(uuid()) @db.Uuid
  niveauId    String  @map("niveau_id") @db.Uuid
  nom         String  @db.VarChar(255)
  quantite    Int     @default(1)
  description String? @db.Text

  niveau Niveau @relation(fields: [niveauId], references: [id], onDelete: Cascade)

  @@map("fourniture")
}

model Cours {
  id              String    @id @default(uuid()) @db.Uuid
  professeurId    String    @map("professeur_id") @db.Uuid
  classeId        String    @map("classe_id") @db.Uuid
  matiereId       String    @map("matiere_id") @db.Uuid
  titre           String    @db.VarChar(255)
  contenu         String?   @db.Text
  type            TypeCours @default(COURS)
  datePublication DateTime  @default(now()) @map("date_publication")

  professeur Utilisateur  @relation("ProfesseurCours", fields: [professeurId], references: [id], onDelete: Cascade)
  classe     Classe       @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere    Matiere      @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  medias     CoursMedia[]

  @@map("cours")
}

model CoursMedia {
  id         String    @id @default(uuid()) @db.Uuid
  coursId    String    @map("cours_id") @db.Uuid
  nomFichier String    @map("nom_fichier") @db.VarChar(255)
  type       TypeMedia
  url        String    @db.VarChar(500)
  taille     BigInt?

  cours Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@map("cours_media")
}

model Evaluation {
  id             String         @id @default(uuid()) @db.Uuid
  matiereId      String         @map("matiere_id") @db.Uuid
  classeId       String         @map("classe_id") @db.Uuid
  professeurId   String         @map("professeur_id") @db.Uuid
  titre          String         @db.VarChar(255)
  type           TypeEvaluation
  coefficient    Decimal        @default(1.00) @db.Decimal(4, 2)
  periode        Periode
  numeroPeriode  Int            @map("numero_periode")
  dateEvaluation DateTime       @map("date_evaluation")

  matiere    Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  classe     Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  professeur Utilisateur @relation("ProfesseurEvaluations", fields: [professeurId], references: [id], onDelete: Cascade)
  notes      Note[]

  @@map("evaluation")
}

model Note {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @map("evaluation_id") @db.Uuid
  eleveId      String   @map("eleve_id") @db.Uuid
  valeur       Decimal  @db.Decimal(5, 2)
  appreciation String?  @db.VarChar(500)
  dateSaisie   DateTime @default(now()) @map("date_saisie")
  saisiePar    String?  @map("saisie_par") @db.Uuid

  evaluation      Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  eleve           Eleve            @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  auteurSaisie    Utilisateur?     @relation("SaisieParUser", fields: [saisiePar], references: [id], onDelete: SetNull)
  bulletinDetails BulletinDetail[]

  @@unique([evaluationId, eleveId])
  @@index([eleveId], map: "idx_note_eleve")
  @@index([evaluationId], map: "idx_note_evaluation")
  @@map("note")
}

model Bulletin {
  id              String   @id @default(uuid()) @db.Uuid
  eleveId         String   @map("eleve_id") @db.Uuid
  periode         Periode
  numeroPeriode   Int      @map("numero_periode")
  anneeScolaire   String   @map("annee_scolaire") @db.VarChar(20)
  moyenneGenerale Decimal? @map("moyenne_generale") @db.Decimal(5, 2)
  rang            Int?
  mention         String?  @db.VarChar(50)
  dateGeneration  DateTime @default(now()) @map("date_generation")
  fichierPdf      String?  @map("fichier_pdf") @db.VarChar(500)

  eleve   Eleve            @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  details BulletinDetail[]

  @@unique([eleveId, periode, numeroPeriode, anneeScolaire])
  @@index([eleveId], map: "idx_bulletin_eleve")
  @@map("bulletin")
}

model BulletinDetail {
  id             String   @id @default(uuid()) @db.Uuid
  bulletinId     String   @map("bulletin_id") @db.Uuid
  noteId         String   @map("note_id") @db.Uuid
  moyenneMatiere Decimal? @map("moyenne_matiere") @db.Decimal(5, 2)
  coefficient    Decimal? @db.Decimal(4, 2)

  bulletin Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, noteId])
  @@map("bulletin_detail")
}

model TransactionFinanciere {
  id                         String          @id @default(uuid()) @db.Uuid
  eleveId                    String          @map("eleve_id") @db.Uuid
  type                       TypeTransaction
  montant                    Decimal         @db.Decimal(12, 2)
  mode                       ModePaiement
  referenceTransaction       String?         @map("reference_transaction") @db.VarChar(100)
  statut                     StatutPaiement  @default(EN_ATTENTE)
  datePaiement               DateTime?       @map("date_paiement")
  dateValidation             DateTime?       @map("date_validation")
  validePar                  String?         @map("valide_par") @db.Uuid
  fichierFacturePdf          String?         @map("fichier_facture_pdf") @db.VarChar(500)
  anneeScolaireReinscription String?         @map("annee_scolaire_reinscription") @db.VarChar(20)

  eleve    Eleve        @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  valideur Utilisateur? @relation("ValideParComptable", fields: [validePar], references: [id], onDelete: SetNull)

  @@index([eleveId], map: "idx_transaction_eleve")
  @@index([statut], map: "idx_transaction_statut")
  @@map("transaction_financiere")
}

model ParametreNotation {
  id                String            @id @default(uuid()) @db.Uuid
  etablissementId   String            @unique @map("etablissement_id") @db.Uuid
  typeEtablissement TypeEtablissement @map("type_etablissement")
  mode              ModeNotation      @default(DEFAUT)
  regleCalcul       Json?             @default("{}") @map("regle_calcul")
  seuilRattrapage   Decimal?          @default(10.00) @map("seuil_rattrapage") @db.Decimal(5, 2)

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@map("parametre_notation")
}

model Communication {
  id              String                @id @default(uuid()) @db.Uuid
  etablissementId String                @map("etablissement_id") @db.Uuid
  type            TypeCommunication
  sousType        SousTypeCommunication @default(GENERALE) @map("sous_type")
  titre           String                @db.VarChar(255)
  contenu         String?               @db.Text
  datePublication DateTime              @default(now()) @map("date_publication")
  publiePar       String?               @map("publie_par") @db.Uuid
  visiblePublic   Boolean               @default(false) @map("visible_public")
  destinataireId  String?               @map("destinataire_id") @db.Uuid
  lu              Boolean               @default(false)

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  auteur        Utilisateur?  @relation("PublieParUser", fields: [publiePar], references: [id], onDelete: SetNull)
  destinataire  Utilisateur?  @relation("DestinataireUser", fields: [destinataireId], references: [id], onDelete: Cascade)

  @@index([destinataireId], map: "idx_communication_destinataire")
  @@index([visiblePublic, etablissementId], map: "idx_communication_visible")
  @@map("communication")
}

model Discussion {
  id          String         @id @default(uuid()) @db.Uuid
  nom         String         @db.VarChar(255)
  type        TypeDiscussion
  referenceId String?        @map("reference_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  membres  DiscussionMembre[]
  messages Message[]

  @@map("discussion")
}

model DiscussionMembre {
  id            String   @id @default(uuid()) @db.Uuid
  discussionId  String   @map("discussion_id") @db.Uuid
  utilisateurId String   @map("utilisateur_id") @db.Uuid
  dateJoin      DateTime @default(now()) @map("date_join")

  discussion  Discussion  @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([discussionId, utilisateurId])
  @@map("discussion_membre")
}

model Message {
  id           String   @id @default(uuid()) @db.Uuid
  discussionId String   @map("discussion_id") @db.Uuid
  expediteurId String   @map("expediteur_id") @db.Uuid
  contenu      String   @db.Text
  dateEnvoi    DateTime @default(now()) @map("date_envoi")
  fichierJoint String?  @map("fichier_joint") @db.VarChar(500)

  discussion Discussion  @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  expediteur Utilisateur @relation(fields: [expediteurId], references: [id], onDelete: Cascade)

  @@index([discussionId], map: "idx_message_discussion")
  @@map("message")
}

model ClubEvenement {
  id              String          @id @default(uuid()) @db.Uuid
  etablissementId String          @map("etablissement_id") @db.Uuid
  nom             String          @db.VarChar(255)
  description     String?         @db.Text
  type            TypeActivite
  dateDebut       DateTime?       @map("date_debut")
  dateFin         DateTime?       @map("date_fin")
  lieu            String?         @db.VarChar(255)
  statut          StatutEvenement @default(EN_PREPARATION)
  budgetEstime    Decimal?        @map("budget_estime") @db.Decimal(12, 2)
  responsableId   String?         @map("responsable_id") @db.Uuid

  etablissement Etablissement               @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  responsable   Utilisateur?                @relation("ResponsableClub", fields: [responsableId], references: [id], onDelete: SetNull)
  activites     Activite[]
  membres       ClubEvenementMembre[]
  organisateurs ClubEvenementOrganisateur[]

  @@map("club_evenement")
}

model Activite {
  id              String   @id @default(uuid()) @db.Uuid
  clubEvenementId String   @map("club_evenement_id") @db.Uuid
  titre           String   @db.VarChar(255)
  description     String?  @db.Text
  dateActivite    DateTime @map("date_activite")
  lieu            String?  @db.VarChar(255)

  clubEvenement ClubEvenement @relation(fields: [clubEvenementId], references: [id], onDelete: Cascade)

  @@index([clubEvenementId], map: "idx_activite_club")
  @@map("activite")
}

model ClubEvenementMembre {
  id              String     @id @default(uuid()) @db.Uuid
  clubEvenementId String     @map("club_evenement_id") @db.Uuid
  eleveId         String     @map("eleve_id") @db.Uuid
  role            RoleMembre @default(MEMBRE)
  dateAdhesion    DateTime   @default(now()) @map("date_adhesion")

  clubEvenement ClubEvenement @relation(fields: [clubEvenementId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([clubEvenementId, eleveId])
  @@map("club_evenement_membre")
}

model ClubEvenementOrganisateur {
  id              String  @id @default(uuid()) @db.Uuid
  clubEvenementId String  @map("club_evenement_id") @db.Uuid
  utilisateurId   String  @map("utilisateur_id") @db.Uuid
  role            String? @db.VarChar(100)

  clubEvenement ClubEvenement @relation(fields: [clubEvenementId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([clubEvenementId, utilisateurId])
  @@map("club_evenement_organisateur")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  utilisateurId  String?  @map("utilisateur_id") @db.Uuid
  action         String   @db.VarChar(100)
  entite         String   @db.VarChar(50)
  entiteId       String?  @map("entite_id") @db.Uuid
  ancienneValeur Json?    @map("ancienne_valeur")
  nouvelleValeur Json?    @map("nouvelle_valeur")
  ipAdresse      String?  @map("ip_adresse") @db.VarChar(45)
  dateAction     DateTime @default(now()) @map("date_action")

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([entite, entiteId], map: "idx_audit_log_entite")
  @@index([dateAction], map: "idx_audit_log_date")
  @@map("audit_log")
}
