# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=gestion_etab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/gestion_etab?schema=public"

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_root_password_here

# JWT & Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
